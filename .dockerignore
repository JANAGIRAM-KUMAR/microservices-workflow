# Secrets — .env holds JWT_SECRET, GATEWAY_SECRET, AWS keys and a DB password.
# Never let it reach the build context or an image layer.
.env
.env.*
!.env.example
*.pem
*.key

# Dependencies are reinstalled inside the image for the correct platform.
node_modules
**/node_modules

