{
  "name": "nodejs_microservices",
  "version": "1.0.0",
  "private": true,
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev:auth": "npm run dev -w auth-service",
    "dev:gateway": "npm run dev -w api-gateway",
    "dev:task": "npm run dev -w task-service",
    "dev:media": "npm run dev -w media-service",
    "dev:workflow": "npm run dev -w workflow-service",
    "db:migrate": "tsx scripts/migrate.ts",
    "kafka:up": "docker compose -f docker/docker-compose.yml up -d",
    "kafka:down": "docker compose -f docker/docker-compose.yml down",
    "kafka:logs": "docker compose -f docker/docker-compose.yml logs -f kafka",
    "up": "docker compose -f docker/docker-compose.yml up -d --build",
    "down": "docker compose -f docker/docker-compose.yml down",
    "logs": "docker compose -f docker/docker-compose.yml logs -f",
    "migrate": "docker compose -f docker/docker-compose.yml run --rm migrate",
    "ps": "docker compose -f docker/docker-compose.yml ps",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit -p packages/shared/tsconfig.json && tsc --noEmit -p apps/api-gateway/tsconfig.json && tsc --noEmit -p apps/auth-service/tsconfig.json && tsc --noEmit -p apps/task-service/tsconfig.json && tsc --noEmit -p apps/media-service/tsconfig.json && tsc --noEmit -p apps/workflow-service/tsconfig.json"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.3",
    "@types/supertest": "^6.0.3",
    "@vitest/coverage-v8": "^3.2.7",
    "supertest": "^7.3.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "share": "^0.7.40"
  }
}
